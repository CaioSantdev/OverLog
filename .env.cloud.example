APP_ORIGIN=https://treinos.seu-dominio.com
JWT_SECRET_KEY=
# Use conexão direta ou Session pooler, porta 5432. Não use Transaction pooler 6543.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
# Certificado CA para o endpoint escolhido, baixado do painel/provedor
SUPABASE_CA_FILE=./deploy/supabase-ca.crt
# Conexão direta: overlog_app. Session pooler: overlog_app.PROJECT_REF
SUPABASE_RUNTIME_USER=
SUPABASE_RUNTIME_PASSWORD=
# Direta: postgres. Session pooler: postgres.PROJECT_REF
SUPABASE_MIGRATION_USER=
SUPABASE_MIGRATION_PASSWORD=
CLOUDFLARE_TUNNEL_TOKEN=
# Opcional: fixe uma versão/digest após validar a imagem escolhida.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
