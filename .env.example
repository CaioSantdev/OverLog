POSTGRES_DB=overlog
POSTGRES_USER=overlog
POSTGRES_PASSWORD=local-development-only
FRONTEND_PORT=5173
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
COOKIE_SECURE=false

# Opcional: hostname do túnel ngrok, sem https:// ou barra final
NGROK_HOST=

# Produção: senha distinta da senha do proprietário do banco (mínimo 16 caracteres)
POSTGRES_APP_USER=overlog_app
POSTGRES_APP_PASSWORD=
